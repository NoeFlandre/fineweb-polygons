    "direction-2-lexical-v2": {
      "description": "V1 plus deterministic OSM reuse, FineWeb document-frequency, and short-name specificity rules.",
      "artifact_prefix": "data/direction-2/lexical-v2/",
      "name_policy": {
        "discard": [
          "names with no letters",
          "names with fewer than three letters",
          "exact source-country names"
        ],
        "generic": [
          "name used by more than one OSM polygon",
          "name occurring in more than 0.1% of FineWeb documents",
          "single-token name with at most eight letters"
        ],
        "distinctive": "all remaining names"
      },
      "generic_match_condition": "The source country must appear independently in the same sentence.",
      "frequency_pass": "Each accepted normalized name is counted once per FineWeb document before retrieval."
    }
  },
