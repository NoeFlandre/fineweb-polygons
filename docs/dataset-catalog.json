        "metadata/v5/liechtenstein/name-frequency.json"
      ],
      "readme": "data/v5/README.md",
      "schema_summary": "V4-style text matching plus OSM uniqueness and a 0.1% FineWeb name-frequency cutoff."
    },
    {
      "id": "v6",
      "kind": "retrieval",
      "countries": ["Monaco", "Liechtenstein"],
      "source_version": null,
      "data_files": [
        {"split": "monaco", "path": "data/v6/monaco-v6-10bt-000-v1.jsonl"},
        {"split": "liechtenstein", "path": "data/v6/liechtenstein-v6-10bt-000-v1.jsonl"}
      ],
      "manifest_files": [
        "metadata/v6/monaco/manifest.json",
        "metadata/v6/monaco/name-frequency.json",
        "metadata/v6/liechtenstein/manifest.json",
        "metadata/v6/liechtenstein/name-frequency.json"
      ],
      "readme": "data/v6/README.md",
      "schema_summary": "V5 plus a 500 normalized-character name/country span limit and two matching-sentence columns."
    },
    {
      "id": "v7",
      "kind": "post_processing",
      "countries": ["Monaco", "Liechtenstein"],
      "source_version": "v6",
      "data_files": [
        {"split": "monaco", "path": "data/v7/monaco-v7-10bt-000-v1.jsonl"},
        {"split": "liechtenstein", "path": "data/v7/liechtenstein-v7-10bt-000-v1.jsonl"}
      ],
      "manifest_files": [
        "metadata/v7/monaco/manifest.json",
        "metadata/v7/liechtenstein/manifest.json"
      ],
      "readme": "data/v7/README.md",
      "schema_summary": "V6 rows plus an ordered, source-reconstructing sentences list from sat-3l-sm."
    },
    {
      "id": "v8",
      "kind": "post_processing",
      "countries": ["Monaco", "Liechtenstein"],
      "source_version": "v7",
      "data_files": [
        {"split": "monaco", "path": "data/v8/monaco-v8-10bt-000-v1-topic.jsonl"},
        {"split": "liechtenstein", "path": "data/v8/liechtenstein-v8-10bt-000-v1-topic.jsonl"}
      ],
      "manifest_files": [
        "metadata/v8/monaco-manifest.json",
        "metadata/v8/liechtenstein-manifest.json",
        "metadata/v8/v8-topic-vocabulary-v1.json"
      ],
      "readme": "data/v8/README.md",
      "schema_summary": "V7 rows whose complete text contains at least one of the 136 approved strong topic terms."
    },
    {
      "id": "v9",
      "kind": "post_processing",
      "countries": ["Monaco", "Liechtenstein"],
      "source_version": "v8",
      "data_files": [
        {"split": "monaco", "path": "data/v9/monaco-v9-10bt-000-v1-topic-sentences.jsonl"},
        {"split": "liechtenstein", "path": "data/v9/liechtenstein-v9-10bt-000-v1-topic-sentences.jsonl"}
      ],
      "manifest_files": [
        "metadata/v9/monaco/manifest.json",
        "metadata/v9/liechtenstein/manifest.json"
      ],
      "readme": "data/v9/README.md",
      "schema_summary": "V9 schema version 4: V8 topic sentences within two sentence positions of polygon evidence, with full text and compact aligned metadata; six redundant V6 matching fields are omitted from rows."
    }
  ]
}
