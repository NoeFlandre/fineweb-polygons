      ],
      "manifest_files": ["metadata/v1/monaco-manifest.json"],
      "readme": "data/v1/README.md",
      "schema_summary": "Original excerpt-only release with text_excerpt and url_excerpt."
    },
    {
      "id": "v2",
      "kind": "retrieval",
      "countries": ["Monaco"],
      "source_version": null,
      "data_files": [
        {"split": "train", "path": "data/v2/monaco-v2-10bt-000-v2.jsonl"}
      ],
      "manifest_files": ["metadata/v2/monaco-manifest.json"],
      "readme": "data/v2/README.md",
      "schema_summary": "Full FineWeb text and URL with meaningful in-boundary polygon matching."
    },
    {
      "id": "v3",
      "kind": "retrieval",
      "countries": ["Monaco"],
      "source_version": null,
      "data_files": [
        {"split": "train", "path": "data/v3/monaco-v3-10bt-000-v1.jsonl"}
      ],
      "manifest_files": ["metadata/v3/monaco-manifest.json"],
      "readme": "data/v3/README.md",
      "schema_summary": "All meaningful polygon areas with strict URL-and-text matching."
    },
    {
      "id": "v4",
      "kind": "retrieval",
      "countries": ["Monaco"],
      "source_version": null,
      "data_files": [
        {"split": "train", "path": "data/v4/monaco-v4-10bt-000-v1.jsonl"}
      ],
      "manifest_files": ["metadata/v4/monaco-manifest.json"],
      "readme": "data/v4/README.md",
      "schema_summary": "All meaningful polygon areas with text-only matching."
    },
    {
      "id": "v5",
      "kind": "retrieval",
      "countries": ["Monaco", "Liechtenstein"],
